# Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Somente no servidor — nunca exponha no navegador
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
# Segredo da rota /api/public/cron/daily-pick (o mesmo valor vai para o Vault como cron_secret)
CRON_SECRET=troque-por-um-valor-longo-e-aleatorio
# Identificação nas APIs públicas (MusicBrainz exige um User-Agent com contato)
ENRICH_USER_AGENT=1001AlbunsClube/1.0 (seu-email@exemplo.com)
